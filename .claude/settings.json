{
  "hooks": {
    "PreToolUse": [
      {"matcher": "Bash", "hooks": [{"type": "command", "command": "python3 .claude/hooks/pre_bash_guard.py"}]},
      {"matcher": "Write|Edit", "hooks": [{"type": "command", "command": "python3 .claude/hooks/pre_write_guard.py"}]}
    ],
    "PostToolUse": [
      {"matcher": "Write|Edit", "hooks": [{"type": "command", "command": "python3 .claude/hooks/post_edit_validate.py"}]},
      {"matcher": "*", "hooks": [{"type": "command", "command": "python3 .claude/hooks/audit_log.py"}]}
    ]
  }
}
